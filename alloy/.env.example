# Grafana Cloud credentials for the k8s-monitoring Helm chart.
# Copy this file to `.env` (gitignored) and fill in the real values.
#
# Where to find these in Grafana Cloud:
#   - Stack ID: top of Grafana Cloud → Stack settings → ID
#   - Tokens:   Connections → Access Policies (or per-product "Send..." pages)

# --- Used by both values files (OTLP variant + non-OTLP backup) ---

# Grafana Cloud stack ID. Used as the basic-auth username for the OTLP
# gateway, the Pyroscope ingest endpoint, and Fleet Management.
GRAFANA_STACK_ID=your-stack-id

# Grafana Cloud API token (starts with "glc_"). Used as the basic-auth
# password for every destination. For the OTLP-only variant a token
# scoped to "otlp:write" is sufficient; for the non-OTLP backup a
# token with metrics-write + logs-write + traces-write is needed.
GRAFANA_CLOUD_TOKEN=your-grafana-cloud-token

# --- Used ONLY by the non-OTLP backup (povsim-k8s-monitoring-values-nonotlp.yaml) ---
# The OTLP variant does not reference these.

# Basic-auth username for the Prometheus remote-write destination.
GRAFANA_METRICS_USERNAME=your-metrics-username

# Basic-auth username for the Loki push destination.
GRAFANA_LOGS_USERNAME=your-logs-username

# Basic-auth username for the dedicated Tempo OTLP HTTP push endpoint.
# Different from STACK_ID — find it in Grafana Cloud → Connections →
# Stack settings → "Send Traces".
GRAFANA_TRACES_USERNAME=your-traces-username
